// Oberfläche von MediaFiles Ferry. Texte stehen auf Englisch in @tr(); Übersetzungen liegen in translations/.
import { Button, Palette } from "std-widgets.slint";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-SemiBold.ttf";
import "fonts/JetBrainsMono-Bold.ttf";

export struct VolumeRow {
    name: string,
    files: string,
    online: bool,
}

// Feste Breite für alle Sprachen; lange Namen kürzt der Rust-Teil in der Mitte ("Anfang…Ende").
export global Metrics {
    out property <length> window-width: 420px;
    out property <length> padding: 32px;
    out property <length> spacing: 24px;
    out property <length> line: 18px;
}

component Section inherits VerticalLayout {
    in property <string> title;
    spacing: 10px;
    Text {
        text: root.title;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1px;
        color: Palette.foreground.with-alpha(0.5);
    }
    @children
}

component Divider inherits Rectangle {
    height: 1px;
    background: Palette.border;
}

component StatusLine inherits Text {
    height: Metrics.line;
    font-size: 12px;
    overflow: elide;
    vertical-alignment: center;
}

export component AppWindow inherits Window {
    title: "MediaFiles Ferry";
    default-font-family: "JetBrains Mono";
    default-font-size: 13px;
    width: Metrics.window-width;
    height: main.preferred-height;

    in property <string> system-name;
    in property <[VolumeRow]> volumes;
    in property <int> minutes-since-scan: -1;
    in property <bool> scanning;
    in property <string> progress;
    in property <int> warnings;
    in property <string> error;
    in property <bool> has-manifest;
    in property <[string]> language-names;
    in property <int> language-index;
    in-out property <bool> dark: true;

    callback scan();
    callback save-manifest();
    callback open-manifest();
    callback import-delivery();
    callback select-language(int);
    callback dark-changed(bool);

    MenuBar {
        Menu {
            title: @tr("Settings");
            Menu {
                title: @tr("Language");
                for name[i] in root.language-names: MenuItem {
                    title: name;
                    checked: i == root.language-index;
                    activated => { root.select-language(i); }
                }
            }
            Menu {
                title: @tr("Appearance");
                MenuItem {
                    title: @tr("Dark");
                    checked: root.dark;
                    activated => { root.dark = true; }
                }
                MenuItem {
                    title: @tr("Light");
                    checked: !root.dark;
                    activated => { root.dark = false; }
                }
            }
        }
    }

    // animierte Punkte hinter "Scanning", damit man sieht, dass etwas läuft
    property <int> dot-count;
    property <string> dots: root.dot-count == 1 ? ".  " : root.dot-count == 2 ? ".. " : root.dot-count == 3 ? "..." : "   ";
    Timer {
        interval: 400ms;
        running: root.scanning;
        triggered => { root.dot-count = Math.mod(root.dot-count + 1, 4); }
    }

    init => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
        root.dark-changed(root.dark);
    }

    property <int> hours: root.minutes-since-scan / 60;
    property <int> days: root.hours / 24;
    property <string> scan-status: root.scanning ? @tr("Scanning{} {}", root.dots, root.progress)
        : root.minutes-since-scan < 0 ? @tr("Not scanned yet")
        : root.minutes-since-scan < 1 ? @tr("Last scan: just now")
        : root.minutes-since-scan < 60 ? @tr("Last scan: {n} minute ago" | "Last scan: {n} minutes ago" % root.minutes-since-scan)
        : root.hours < 24 ? @tr("Last scan: {n} hour ago" | "Last scan: {n} hours ago" % root.hours)
        : @tr("Last scan: {n} day ago" | "Last scan: {n} days ago" % root.days);

    main := VerticalLayout {
        padding: Metrics.padding;
        spacing: Metrics.spacing;

        VerticalLayout {
            padding-top: 8px;
            padding-bottom: 12px;
            Text {
                text: "MEDIAFILES FERRY";
                font-family: "Helvetica Neue";
                font-size: 26px;
                font-weight: 300;
                letter-spacing: 3px;
                color: Palette.foreground;
            }
        }

        Section {
            title: @tr("THIS SYSTEM");
            Text {
                text: root.system-name;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
                color: Palette.foreground;
            }
            if root.volumes.length == 0: Text {
                text: @tr("No drive with “Avid MediaFiles/MXF” found.");
                overflow: elide;
                color: Palette.foreground.with-alpha(0.6);
            }
            for v in root.volumes: HorizontalLayout {
                spacing: 10px;
                height: Metrics.line;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: v.online ? #3fb950 : Palette.border;
                    }
                }
                Text {
                    text: v.name;
                    horizontal-stretch: 1;
                    overflow: elide;
                    vertical-alignment: center;
                    color: v.online ? Palette.foreground : Palette.foreground.with-alpha(0.5);
                }
                Text {
                    text: v.files == "" ? @tr("not scanned yet") : @tr("{} files", v.files);
                    vertical-alignment: center;
                    color: Palette.foreground.with-alpha(v.files == "" ? 0.35 : 0.6);
                }
            }
            VerticalLayout {
                StatusLine {
                    text: root.scan-status;
                    color: Palette.foreground.with-alpha(0.6);
                }
                // feste Zeile, damit das Fenster nicht springt, wenn ein Hinweis erscheint
                StatusLine {
                    text: root.error != "" ? root.error : root.warnings > 0 && !root.scanning ? @tr("{n} warning" | "{n} warnings" % root.warnings) : "";
                    color: root.error != "" ? #f85149 : #d29922;
                }
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Button {
                    text: @tr("Scan");
                    primary: true;
                    enabled: !root.scanning && root.volumes.length > 0;
                    clicked => { root.scan(); }
                }
                Button {
                    text: @tr("Save manifest…");
                    enabled: root.has-manifest && !root.scanning;
                    clicked => { root.save-manifest(); }
                }
            }
        }

        Divider { }

        Section {
            title: @tr("COMPARE");
            HorizontalLayout {
                alignment: start;
                Button {
                    text: @tr("Open manifest…");
                    enabled: false;
                    clicked => { root.open-manifest(); }
                }
            }
        }

        Divider { }

        Section {
            title: @tr("RECEIVED A DELIVERY?");
            HorizontalLayout {
                alignment: start;
                Button {
                    text: @tr("Verify & import…");
                    enabled: false;
                    clicked => { root.import-delivery(); }
                }
            }
        }
    }
}
