// Oberfläche von MediaFiles Ferry. Texte stehen auf Englisch in @tr(); Übersetzungen liegen in translations/.
import { Palette } from "std-widgets.slint";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-SemiBold.ttf";
import "fonts/JetBrainsMono-Bold.ttf";

export struct VolumeRow {
    name: string,
    files: string,
    online: bool,
}

export struct MenuChoice {
    title: string,
    checked: bool,
}

// Feste Breite für alle Sprachen; lange Namen kürzt der Rust-Teil in der Mitte ("Anfang…Ende").
export global Metrics {
    out property <length> window-width: 420px;
    out property <length> padding: 32px;
    out property <length> spacing: 24px;
    out property <length> line: 18px;
}

// Eigene Farben statt Standard-Transparenzen: im hellen Modus braucht Sekundärtext deutlich mehr Kontrast.
export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> background: dark ? #1f2225 : #f5f5f3;
    out property <color> text: dark ? #eceded : #17191b;
    out property <color> muted: dark ? #a9adb1 : #3f444a;
    out property <color> faint: dark ? #7c8288 : #60666c;
    out property <color> line: dark ? #3a3f44 : #c4c8cc;
    out property <color> disabled: dark ? #6a7076 : #70767c;
    out property <color> primary: dark ? #e6e7e8 : #2e3236;
    out property <color> on-primary: dark ? #1f2225 : #f5f5f3;
    out property <color> online: dark ? #3fb950 : #1f883d;
    out property <color> warning: dark ? #d29922 : #8a5a00;
    out property <color> error: dark ? #f85149 : #c62828;
}

component Section inherits VerticalLayout {
    in property <string> title;
    spacing: 10px;
    Text {
        text: root.title;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1px;
        color: Theme.muted;
    }
    @children
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.line;
}

component StatusLine inherits Text {
    height: Metrics.line;
    font-size: 12px;
    overflow: elide;
    vertical-alignment: center;
}

component FerryButton {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked;
    min-width: label.preferred-width + 28px;
    preferred-width: self.min-width;
    height: 32px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Rectangle {
        border-radius: 6px;
        border-width: 1px;
        border-color: root.primary && root.enabled ? Theme.primary : Theme.line;
        background: !root.enabled ? transparent
            : root.primary ? (touch.pressed ? Theme.primary.darker(0.15) : Theme.primary)
            : touch.pressed ? Theme.text.with-alpha(0.12) : touch.has-hover ? Theme.text.with-alpha(0.06) : transparent;
    }
    label := Text {
        text: root.text;
        font-weight: root.primary ? 600 : 400;
        color: !root.enabled ? Theme.disabled : root.primary ? Theme.on-primary : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "MediaFiles Ferry";
    default-font-family: "JetBrains Mono";
    default-font-size: 13px;
    background: Theme.background;
    width: Metrics.window-width;
    height: main.preferred-height;

    in property <string> system-name;
    in property <[VolumeRow]> volumes;
    in property <int> minutes-since-scan: -1;
    in property <bool> scanning;
    in property <string> progress;
    in property <int> warnings;
    in property <string> error;
    in property <bool> has-manifest;
    in property <string> language: "en";
    in property <[MenuChoice]> languages;
    in property <[bool]> appearance;
    in property <bool> dark: true;

    callback scan();
    callback save-manifest();
    callback open-manifest();
    callback import-delivery();
    callback select-language(int);
    callback select-dark(bool);

    init => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }

    // Die Einträge kommen als Modell aus Rust und werden nach jeder Auswahl neu gesetzt, damit die Häkchen stimmen.
    MenuBar {
        Menu {
            title: @tr("Settings");
            Menu {
                title: @tr("Language");
                for l[i] in root.languages: MenuItem {
                    title: l.title;
                    checkable: true;
                    checked: l.checked;
                    activated => { root.select-language(i); }
                }
            }
            Menu {
                title: @tr("Appearance");
                for checked[i] in root.appearance: MenuItem {
                    title: i == 0 ? @tr("Dark") : @tr("Light");
                    checkable: true;
                    checked: checked;
                    activated => { root.select-dark(i == 0); }
                }
            }
        }
    }

    // animierte Punkte hinter "Scanning", damit man sieht, dass etwas läuft
    property <int> dot-count;
    property <string> dots: root.dot-count == 1 ? ".  " : root.dot-count == 2 ? ".. " : root.dot-count == 3 ? "..." : "   ";
    Timer {
        interval: 400ms;
        running: root.scanning;
        triggered => { root.dot-count = Math.mod(root.dot-count + 1, 4); }
    }

    property <int> hours: root.minutes-since-scan / 60;
    property <int> days: root.hours / 24;
    property <string> scan-status: root.scanning ? @tr("Scanning{} {}", root.dots, root.progress)
        : root.minutes-since-scan < 0 ? @tr("Not scanned yet")
        : root.minutes-since-scan < 1 ? @tr("Last scan: just now")
        : root.minutes-since-scan < 60 ? @tr("Last scan: {n} minute ago" | "Last scan: {n} minutes ago" % root.minutes-since-scan)
        : root.hours < 24 ? @tr("Last scan: {n} hour ago" | "Last scan: {n} hours ago" % root.hours)
        : @tr("Last scan: {n} day ago" | "Last scan: {n} days ago" % root.days);

    main := VerticalLayout {
        padding: Metrics.padding;
        spacing: Metrics.spacing;

        VerticalLayout {
            padding-top: 8px;
            padding-bottom: 12px;
            Text {
                text: "MEDIAFILES FERRY";
                font-family: "Helvetica Neue";
                font-size: 31px;
                font-weight: 300;
                letter-spacing: 2.5px;
                color: Theme.text;
            }
        }

        Section {
            title: @tr("THIS SYSTEM");
            Text {
                text: root.system-name;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
                color: Theme.text;
            }
            if root.volumes.length == 0: Text {
                text: @tr("No drive with “Avid MediaFiles/MXF” found.");
                overflow: elide;
                color: Theme.muted;
            }
            for v in root.volumes: HorizontalLayout {
                spacing: 10px;
                height: Metrics.line;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: v.online ? Theme.online : Theme.line;
                    }
                }
                Text {
                    text: v.name;
                    horizontal-stretch: 1;
                    overflow: elide;
                    vertical-alignment: center;
                    color: v.online ? Theme.text : Theme.muted;
                }
                Text {
                    text: v.files == "" ? @tr("not scanned yet") : @tr("{} files", v.files);
                    vertical-alignment: center;
                    color: v.files == "" ? Theme.faint : Theme.muted;
                }
            }
            VerticalLayout {
                StatusLine {
                    text: root.scan-status;
                    color: Theme.muted;
                }
                // feste Zeile, damit das Fenster nicht springt, wenn ein Hinweis erscheint
                StatusLine {
                    text: root.error != "" ? root.error : root.warnings > 0 && !root.scanning ? @tr("{n} warning" | "{n} warnings" % root.warnings) : "";
                    color: root.error != "" ? Theme.error : Theme.warning;
                }
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                FerryButton {
                    text: @tr("Scan");
                    primary: true;
                    enabled: !root.scanning && root.volumes.length > 0;
                    clicked => { root.scan(); }
                }
                FerryButton {
                    text: @tr("Save manifest…");
                    enabled: root.has-manifest && !root.scanning;
                    clicked => { root.save-manifest(); }
                }
            }
        }

        Divider { }

        Section {
            title: @tr("COMPARE");
            HorizontalLayout {
                alignment: start;
                FerryButton {
                    text: @tr("Open manifest…");
                    enabled: false;
                    clicked => { root.open-manifest(); }
                }
            }
        }

        Divider { }

        Section {
            title: @tr("RECEIVED A DELIVERY?");
            HorizontalLayout {
                alignment: start;
                FerryButton {
                    text: @tr("Verify & import…");
                    enabled: false;
                    clicked => { root.import-delivery(); }
                }
            }
        }
    }
}
